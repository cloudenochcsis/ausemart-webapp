@page
@model SuccessModel
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="text-center my-5">
    <h1 class="display-4 text-success">Order Confirmed!</h1>
    <div class="my-4">
        <i class="bi bi-check-circle-fill" style="font-size: 5rem; color: green;"></i>
    </div>
    <p class="lead">Thank you for your purchase from Aus-E-Mart!</p>
    <p>Your order has been successfully processed.</p>
    <p>You would normally receive an email confirmation with your order details.</p>
    
    <div class="mt-5">
        <a asp-page="/Products" class="btn btn-primary">Continue Shopping</a>
    </div>
</div>
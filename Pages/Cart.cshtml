@page
@model CartModel
@{
    ViewData["Title"] = "Aus-E-Mart Shopping Cart";
}
<h1>@ViewData["Title"]</h1>

@if (!Model.CartItems.Any())
{
    <div class="alert alert-info">
        Your shopping cart is empty. <a asp-page="/Products">Continue shopping</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: cover; margin-right: 10px;">
                                <span>@item.ProductName</span>
                            </div>
                        </td>
                        <td>$@item.Price.ToString("F2")</td>
                        <td>
                            <form method="post" asp-page-handler="UpdateQuantity" class="d-flex align-items-center">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="width: 80px;" />
                                <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Update</button>
                            </form>
                        </td>
                        <td>$@item.Total.ToString("F2")</td>
                        <td>
                            <form method="post" asp-page-handler="RemoveItem">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                    <td><strong>$@Model.CartTotal.ToString("F2")</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <form method="post" asp-page-handler="ClearCart">
            <button type="submit" class="btn btn-outline-danger">Clear Cart</button>
        </form>
        
        <div>
            <a asp-page="/Products" class="btn btn-outline-secondary me-2">Continue Shopping</a>
            <form method="post" asp-page-handler="Checkout" class="d-inline">
                <button type="submit" class="btn btn-success">Checkout</button>
            </form>
        </div>
    </div>
}

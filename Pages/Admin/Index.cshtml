@page
@model ausemartweb.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container my-5">
    <h1 class="mb-4">Admin Dashboard</h1>
    
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Products Management</h3>
                </div>
                <div class="card-body">
                    <p>Manage your product inventory, pricing, and categories.</p>
                    <a href="/Admin/Products" class="btn btn-primary">
                        <i class="fas fa-box me-2"></i> Manage Products
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Orders</h3>
                </div>
                <div class="card-body">
                    <p>View and manage customer orders and shipping status.</p>
                    <a href="#" class="btn btn-success">
                        <i class="fas fa-shipping-fast me-2"></i> Manage Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">Categories</h3>
                </div>
                <div class="card-body">
                    <p>Create and manage product categories.</p>
                    <a href="#" class="btn btn-info">
                        <i class="fas fa-tags me-2"></i> Manage Categories
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">Users</h3>
                </div>
                <div class="card-body">
                    <p>Manage user accounts and roles.</p>
                    <a href="#" class="btn btn-warning">
                        <i class="fas fa-users me-2"></i> Manage Users
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-end mt-3">
        <a href="/" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Back to Store
        </a>
    </div>
</div>
@page "{id:int?}"
@model ProductEditModel
@{
    ViewData["Title"] = Model.Product.Id == 0 ? "Add Product" : "Edit Product";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" asp-for="Product.Id" />
            
            <div class="mb-3">
                <label asp-for="Product.Name" class="form-label">Product Name</label>
                <input asp-for="Product.Name" class="form-control" required />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Product.Description" class="form-label">Description</label>
                <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Product.Description" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Product.Price" class="form-label">Price</label>
                <input asp-for="Product.Price" class="form-control" type="number" step="0.01" min="0.01" required />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Product.ImageUrl" class="form-label">Image URL</label>
                <input asp-for="Product.ImageUrl" class="form-control" />
                <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
                <div class="form-text">For this demo, please use one of: /images/kangaroo.jpg, /images/koala.jpg, or /images/spider.jpg</div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Product.StockQuantity" class="form-label">Stock Quantity</label>
                <input asp-for="Product.StockQuantity" class="form-control" type="number" min="0" required />
                <span asp-validation-for="Product.StockQuantity" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Product.Category" class="form-label">Category</label>
                <select asp-for="Product.Category" class="form-select">
                    <option value="Toys">Toys</option>
                    <option value="Apparel">Apparel</option>
                    <option value="Accessories">Accessories</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Product.Category" class="text-danger"></span>
            </div>
            
            <div class="mb-3 d-flex justify-content-between">
                <a asp-page="./Products" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
    {
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Product Image Preview</div>
                <div class="card-body text-center">
                    <img src="@Model.Product.ImageUrl" alt="Product Image" class="img-fluid" style="max-height: 300px;" />
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}